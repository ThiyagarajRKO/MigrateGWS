# Google OAuth Configuration
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# NextAuth Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your_nextauth_secret_here

# Database Configuration (Future use)
DATABASE_URL=postgresql://username:password@localhost:5432/gws_migration
MONGODB_URI=mongodb://localhost:27017/gws_migration

# Redis Configuration (Future use)
REDIS_URL=redis://localhost:6379

# Application Configuration
NODE_ENV=development
APP_URL=http://localhost:3000

# Google Workspace API Configuration
GOOGLE_WORKSPACE_DOMAIN=your-workspace-domain.com
GOOGLE_WORKSPACE_CUSTOMER_ID=your_customer_id

# Migration Configuration
MAX_CONCURRENT_MIGRATIONS=5
BATCH_SIZE=100
RETRY_ATTEMPTS=3

# Logging
LOG_LEVEL=info
