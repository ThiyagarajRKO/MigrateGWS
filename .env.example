# Environment Configuration for GWS Migration Platform
# Copy this to .env for development and production

# Database Configuration
# DATABASE_URL="your-database-connection-string"

# Google Workspace Configuration
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Development & Testing
NODE_ENV=development

# 🧪 DELEGATION TESTING (Development Only)
# Set to 'true' to enable delegation testing mode
# WARNING: This bypasses delegation verification - for development only!
NEXT_PUBLIC_ENABLE_DELEGATION_TESTING=true

# 🔧 DELEGATION SETUP STATUS
# Track delegation configuration progress
DELEGATION_SETUP_COMPLETED=false
DELEGATION_VERIFIED_DATE=""

# 📋 ADMIN CONTACT INFO
# Update when delegation is configured
MIGRATE_ARAKUTOURISM_ADMIN_EMAIL="admin@migrate.arakutourism.net"
DELEGATION_CONFIGURED_BY=""
DELEGATION_CONFIGURATION_DATE=""

# 🚨 SECURITY NOTES
# - NEXT_PUBLIC_ENABLE_DELEGATION_TESTING should be 'false' in production
# - Real delegation must be configured before production deployment
# - Remove testing flags once proper delegation is set up
# - Never commit real admin credentials to version control

# 📚 SETUP GUIDES
# - See DOMAIN_WIDE_DELEGATION_SETUP.md for delegation setup
# - Run 'node verify-delegation-setup-complete.mjs' to verify setup
# - Use 'node fix-delegation-issues.mjs' for troubleshooting
