# Real Data Testing Environment Configuration
# Copy this to .env.local and configure with your actual test domains

# Test Domain Configuration (REQUIRED)
TEST_SOURCE_DOMAIN=your-source-domain.com
TEST_TARGET_DOMAIN=your-target-domain.com

# Test User Configuration (REQUIRED)
TEST_SOURCE_USER=testuser@your-source-domain.com
TEST_TARGET_USER=testuser@your-target-domain.com
TEST_SOURCE_ADMIN=admin@your-source-domain.com
TEST_TARGET_ADMIN=admin@your-target-domain.com

# Google Service Account Configuration (REQUIRED)
GOOGLE_SERVICE_ACCOUNT_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----"
GOOGLE_SERVICE_ACCOUNT_PROJECT_ID=your-google-cloud-project-id

# Testing Mode Configuration
REAL_DATA_MODE=false          # Set to 'true' to use real Google Workspace APIs
DRY_RUN=true                 # Set to 'false' to perform actual migrations (DANGEROUS!)
SKIP_CONFIRMATION=false      # Set to 'true' to skip safety confirmation prompts

# Additional Security
VERIFICATION_TOKEN_SIGNING_ENABLED=true
VERIFICATION_TOKEN_ENCRYPTION_ENABLED=false
VERIFICATION_TOKEN_SECRET=your-production-secret-key-here

# Development
NODE_ENV=development
NEXTAUTH_URL=http://localhost:3001
NEXTAUTH_SECRET=your-nextauth-secret-here
